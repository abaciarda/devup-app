{
  "name": "devup-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,yaml,yml}\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,yaml,yml}\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/check-db.ts",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "db:check-editorial": "tsx scripts/check-editorial.ts",
    "foundation:check": "node --conditions=react-server --import tsx scripts/check-foundations.ts",
    "db:check-coordination": "node --conditions=react-server --import tsx scripts/check-coordination.ts",
    "sources:check": "node --conditions=react-server --import tsx scripts/check-sources.ts",
    "db:check-ingestion": "node --conditions=react-server --import tsx scripts/check-ingestion.ts",
    "sources:probe": "node --conditions=react-server --import tsx scripts/probe-sources.ts",
    "sources:refresh": "node --conditions=react-server --import tsx scripts/refresh-sources.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.22.0"
}
