{
  "name": "devup-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,yaml,yml}\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,yaml,yml}\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "node scripts/prisma-safe.mjs db push",
    "db:seed": "node scripts/prisma-safe.mjs db seed",
    "db:backup": "node scripts/backup-database.mjs",
    "db:restore": "node scripts/restore-database.mjs",
    "db:safety:check": "node scripts/check-database-safety.mjs",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/check-db.ts",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "db:check-editorial": "tsx scripts/check-editorial.ts",
    "foundation:check": "node --conditions=react-server --import tsx scripts/check-foundations.ts",
    "db:check-coordination": "node --conditions=react-server --import tsx scripts/check-coordination.ts",
    "sources:check": "node --conditions=react-server --import tsx scripts/check-sources.ts",
    "sources:articles:check": "node --conditions=react-server --import tsx scripts/check-article-sources.ts",
    "db:check-ingestion": "node --conditions=react-server --import tsx scripts/check-ingestion.ts",
    "sources:probe": "node --conditions=react-server --import tsx scripts/probe-sources.ts",
    "sources:refresh": "node --conditions=react-server --import tsx scripts/refresh-sources.ts",
    "draft:check": "node --conditions=react-server --import tsx scripts/check-drafts.ts",
    "db:check-drafts": "node --conditions=react-server --import tsx scripts/check-draft-storage.ts",
    "issue:generate": "node --conditions=react-server --import tsx scripts/generate-issue.ts",
    "admin:check": "node --conditions=react-server --import tsx scripts/check-admin.ts",
    "publication:check": "node --conditions=react-server --import tsx scripts/check-publication.ts",
    "db:check-publication": "node --conditions=react-server --import tsx scripts/check-publication-storage.ts",
    "public:check": "node --conditions=react-server --import tsx scripts/check-public-issues.ts",
    "db:check-public": "node --conditions=react-server --import tsx scripts/check-public-storage.ts",
    "email:check": "node --import tsx scripts/check-email.ts",
    "email:preview": "node --import tsx scripts/preview-email.ts",
    "db:check-email": "node --conditions=react-server --import tsx scripts/check-email-storage.ts",
    "subscription:check": "node --conditions=react-server --import tsx scripts/check-subscriptions.ts",
    "db:check-subscriptions": "node --conditions=react-server --import tsx scripts/check-subscription-storage.ts",
    "subscription:http:check": "node --conditions=react-server --import tsx scripts/check-subscription-http.ts",
    "delivery:check": "node --conditions=react-server --import tsx scripts/check-delivery.ts",
    "db:check-delivery": "node --conditions=react-server --import tsx scripts/check-delivery-storage.ts",
    "delivery:http:check": "node --conditions=react-server --import tsx scripts/check-delivery-http.ts",
    "db:migrate:deploy": "node scripts/prisma-safe.mjs migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "launch:check": "node --conditions=react-server --import tsx scripts/check-launch.ts",
    "operations:check": "node --conditions=react-server --import tsx scripts/check-operations.ts",
    "db:check-operations": "node --conditions=react-server --import tsx scripts/check-operations-storage.ts",
    "operations:http:check": "node --conditions=react-server --import tsx scripts/check-operations-http.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/render": "2.1.0",
    "htmlparser2": "8.0.2",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.1",
    "server-only": "0.0.1",
    "svix": "2.8.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.22.0"
}
