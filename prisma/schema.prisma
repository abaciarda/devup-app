generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GenerationStatus {
  draft
  ready
  failed
}

enum EmailLanguage {
  en
  tr
}

enum SubscriberStatus {
  pending
  confirmed
  unsubscribed
  suppressed
}

enum SendStatus {
  pending
  accepted
  failed
  unknown
  suppressed
}

model Source {
  id        Int       @id @default(autoincrement())
  key       String    @unique
  enabled   Boolean   @default(true)
  config    Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  rawItems  RawItem[]
}

model RawItem {
  id            Int       @id @default(autoincrement())
  sourceId      Int
  source        Source    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalId    String
  title         String
  originalUrl   String
  normalizedUrl String
  excerpt       String    @default("")
  publishedAt   DateTime?
  fetchedAt     DateTime  @default(now())
  score         Float     @default(0)
  tags          String[]  @default([])
  usedIssueId   Int?
  usedIssue     Issue?    @relation(fields: [usedIssueId], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([sourceId, externalId])
  @@index([normalizedUrl])
  @@index([usedIssueId, publishedAt])
}

model Issue {
  id                          Int              @id @default(autoincrement())
  editionDate                 DateTime         @unique @db.Date
  generationStatus            GenerationStatus @default(draft)
  content                     Json?
  generationModel             String?
  generationUsage             Json?
  generationError             String?
  publishedAt                 DateTime?
  deliveryStartedAt           DateTime?
  deliveryFinishedAt          DateTime?
  scheduledGenerationAttempts Int              @default(0)
  rawItems                    RawItem[]
  sendLogs                    SendLog[]
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  @@index([publishedAt, editionDate])
}

model Subscriber {
  id                         String             @id @default(uuid())
  email                      String             @unique @db.VarChar(254)
  language                   EmailLanguage
  status                     SubscriberStatus   @default(pending)
  subscriptionVersion        Int                @default(1)
  consentAt                  DateTime           @db.Timestamptz(3)
  consentVersion             String             @db.VarChar(100)
  confirmedAt                DateTime?          @db.Timestamptz(3)
  unsubscribedAt             DateTime?          @db.Timestamptz(3)
  suppressedAt               DateTime?          @db.Timestamptz(3)
  suppressionReason          String?            @db.VarChar(100)
  confirmationTokenHash      String?            @unique @db.VarChar(64)
  confirmationIssuedAt       DateTime?          @db.Timestamptz(3)
  confirmationExpiresAt      DateTime?          @db.Timestamptz(3)
  confirmationSendId         String?            @unique
  confirmationPayload        Json?
  confirmationIdempotencyKey String?            @unique @db.VarChar(256)
  confirmationStatus         SendStatus?
  confirmationAttempts       Int                @default(0)
  confirmationRetryable      Boolean            @default(false)
  confirmationNeedsReview    Boolean            @default(false)
  confirmationFirstAttemptAt DateTime?          @db.Timestamptz(3)
  confirmationLastAttemptAt  DateTime?          @db.Timestamptz(3)
  confirmationNextAttemptAt  DateTime?          @db.Timestamptz(3)
  confirmationProviderId     String?            @unique
  confirmationAcceptedAt     DateTime?          @db.Timestamptz(3)
  confirmationDeliveredAt    DateTime?          @db.Timestamptz(3)
  confirmationBouncedAt      DateTime?          @db.Timestamptz(3)
  confirmationComplainedAt   DateTime?          @db.Timestamptz(3)
  confirmationError          String?
  sendLogs                   SendLog[]
  confirmationSends          ConfirmationSend[]
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([status, id])
  @@index([status, confirmationExpiresAt])
  @@index([confirmationStatus, confirmationNextAttemptAt])
}

model SendLog {
  id                  String        @id @default(uuid())
  issueId             Int
  issue               Issue         @relation(fields: [issueId], references: [id], onDelete: Restrict)
  subscriberId        String
  subscriber          Subscriber    @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  subscriptionVersion Int
  language            EmailLanguage
  payload             Json
  idempotencyKey      String        @unique @db.VarChar(256)
  status              SendStatus    @default(pending)
  attempts            Int           @default(0)
  retryable           Boolean       @default(false)
  needsReview         Boolean       @default(false)
  firstAttemptAt      DateTime?     @db.Timestamptz(3)
  lastAttemptAt       DateTime?     @db.Timestamptz(3)
  nextAttemptAt       DateTime?     @db.Timestamptz(3)
  providerId          String?       @unique
  acceptedAt          DateTime?     @db.Timestamptz(3)
  deliveredAt         DateTime?     @db.Timestamptz(3)
  bouncedAt           DateTime?     @db.Timestamptz(3)
  complainedAt        DateTime?     @db.Timestamptz(3)
  lastError           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([issueId, subscriberId])
  @@index([issueId, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
  @@index([subscriberId])
}

model ConfirmationSend {
  id             String     @id
  subscriberId   String
  subscriber     Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  firstAttemptAt DateTime   @db.Timestamptz(3)
  providerId     String?    @unique
  acceptedAt     DateTime?  @db.Timestamptz(3)
  deliveredAt    DateTime?  @db.Timestamptz(3)
  bouncedAt      DateTime?  @db.Timestamptz(3)
  complainedAt   DateTime?  @db.Timestamptz(3)

  @@index([subscriberId])
}

model RateLimit {
  key             String   @id
  hits            Int
  windowStartedAt DateTime @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model CleanupRun {
  date       DateTime  @id @db.Date
  startedAt  DateTime  @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  counts     Json?
}

model PipelineLease {
  key        String   @id
  ownerToken String
  expiresAt  DateTime @db.Timestamptz(3)
}
